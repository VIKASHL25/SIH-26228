{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cv-assurance-backend.onrender.com/api/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "https://cv-assurance-backend.onrender.com/data/:path*"
    },
    {
      "source": "/demo_assets/:path*",
      "destination": "https://cv-assurance-backend.onrender.com/demo_assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
